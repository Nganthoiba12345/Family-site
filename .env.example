# Database Configuration (SQLite file path)
# For local development: file:./data/family.db
# For Docker: file:/app/data/family.db
DATABASE_URL=file:./data/family.db

# Redis Caching
# For local development: redis://localhost:6379
# For Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379

# Payload CMS Authentication Secret (Generate a secure random string in production)
PAYLOAD_SECRET=family-heritage-secret-key-change-in-production-12345

# Server Port
PORT=3000
